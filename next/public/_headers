# Cloudflare Workers static-asset headers (copied into .open-next/assets by the
# build). Next content-hashes everything under /_next/static, so a year-long
# immutable TTL is safe; before this every navigation revalidated ~20 files.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be re-checked so push fixes roll out.
/sw.js
  Cache-Control: no-cache
